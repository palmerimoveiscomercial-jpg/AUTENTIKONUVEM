# Variáveis de ambiente de exemplo
# Copie este arquivo para `.env` antes de usar (ex: `cp .env.example .env`) e altere as senhas/valores.

# MySQL (porta padrão 3306)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_DATABASE=app_db
MYSQL_USER=app
MYSQL_PASSWORD=change_me_mysql_pw

# MariaDB (mapeado para 3307 localmente para evitar conflito com MySQL)
MARIADB_PORT=3307
MARIADB_ROOT_PASSWORD=change_me_maria_root
MARIADB_DATABASE=app_db
MARIADB_USER=app
MARIADB_PASSWORD=change_me_maria_pw

# Supabase / Postgres
SUPABASE_PORT=5432
SUPABASE_POSTGRES_PASSWORD=change_me_supabase_pw
SUPABASE_DB=supabase_db

# Observações:
# - Altere todas as senhas para valores fortes antes de usar em produção.
# - Supabase é baseado em PostgreSQL; ele não substitui MySQL/MariaDB.
