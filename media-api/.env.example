SUPABASE_URL=https://replace-project.supabase.co
# Opcional para domínio customizado. No projeto padrão, é derivado como
# https://replace-project.storage.supabase.co
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_ROLE_KEY=replace_only_in_vercel
AUT_MEDIA_SIGNING_SECRET=replace_with_at_least_32_random_characters
AUTENTIKO_ALLOWED_ORIGINS=https://script.google.com
# Ative somente depois que o worker Supabase -> Drive estiver publicado,
# credenciado e validado de ponta a ponta.
AUT_DRIVE_SYNC_WORKER_ENABLED=false
ADOBE_ENABLED=false
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_WEBHOOK_SECRET=
ADOBE_MONTHLY_LIMIT=500

# Neon/Vercel — índice de busca e motor contratual. Use uma conexão pooled do
# Neon e segredos diferentes entre si. Nunca exponha estas variáveis ao browser.
DATABASE_URL=postgresql://user:password@replace-pooler.region.aws.neon.tech/neondb?sslmode=require
AUT_DATA_API_KEY=replace_with_at_least_32_random_characters
AUT_DATA_SYNC_SECRET=replace_with_another_32_random_characters
AUT_DATA_ALLOWED_ORIGINS=https://script.google.com,https://script.googleusercontent.com
# Somente após sincronização completa, testes de aceitação e homologação jurídica.
AUT_CONTRACT_FINAL_ENABLED=false

# Consultas externas e IA. BrasilAPI não exige instalação nem chave.
TRANSPARENCIA_API_KEY=
DATAJUD_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AUT_DATA_PUBLIC_URL=
